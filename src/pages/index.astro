<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Buxton ADR is preparing for launch."
		/>
		<title>Buxton ADR</title>

		<style>
			:root {
				--ink: #1a2e3b;
				--burgundy: #7a1f33;
				--paper: #f7f9fa;
				--line: #d0dbe2;
				--muted: #5f707a;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
			}

			body {
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 2rem;
				background: var(--paper);
				color: var(--ink);
				font-family: Arial, Helvetica, sans-serif;
			}

			main {
				width: 100%;
				max-width: 680px;
				text-align: center;
			}

			img {
				display: block;
				width: 190px;
				max-width: 100%;
				height: auto;
				margin: 0 auto 2rem;
			}

			.rule {
				width: 90px;
				height: 3px;
				margin: 0 auto 1.75rem;
				background: var(--burgundy);
			}

			h1 {
				margin: 0;
				font-family: Georgia, "Times New Roman", serif;
				font-size: clamp(2.25rem, 6vw, 4rem);
				font-weight: 600;
				line-height: 1.05;
				color: var(--ink);
			}

			p {
				margin: 1.25rem auto 0;
				max-width: 560px;
				font-size: 1.05rem;
				line-height: 1.7;
				color: var(--muted);
			}

			.contact {
				margin-top: 2rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--line);
			}

			a {
				color: var(--burgundy);
				font-weight: 700;
				text-decoration: none;
			}

			a:hover {
				text-decoration: underline;
			}
		</style>
	</head>

	<body>
		<main>
			<img
				src="/Buxton ADR Badge - Transparent.png"
				alt="Buxton ADR"
			/>

			<div class="rule" aria-hidden="true"></div>

			<h1>Final preparations are underway.</h1>

			<p>
				The new Buxton ADR website is currently being prepared for launch.
				Please check back soon.
			</p>

			<p class="contact">
				For inquiries, please contact
				<a href="mailto:admin@buxtonadr.ca">admin@buxtonadr.ca</a>.
			</p>
		</main>
	</body>
</html>