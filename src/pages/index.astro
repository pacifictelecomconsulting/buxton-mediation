---
import '../styles/global.css';

const navLinks = [
	{ href: '#practice', label: 'Practice' },
	{ href: '#about', label: 'About' },
	{ href: '#med-arb', label: 'Med-Arb' },
];

const practice = [
	{
		title: 'Mediation',
		featured: false,
		body: 'A structured process where Peter facilitates negotiation between parties. He asks the right questions, reads what is not being said, and helps both sides arrive at a resolution they can stand behind. <strong class="font-semibold text-slate-ink">Seventy to eighty percent of med-arb files settle at this stage.</strong>',
	},
	{
		title: 'Med-Arb',
		featured: true,
		body: 'The process begins as a mediation. If the parties reach an agreement, the file closes. If they don’t, Peter moves seamlessly into the role of arbitrator and delivers a binding decision. <strong class="font-semibold text-slate-ink">One neutral. One process. Resolution accomplished.</strong>',
	},
	{
		title: 'Arbitration',
		featured: false,
		body: '<strong class="font-semibold text-slate-ink">When a decision needs to be made, Peter makes it.</strong> As a trial lawyer with five decades of courtroom experience, he understands what evidence means, how findings of fact are made, and how a written decision captures that.',
	},
];

const worksWith = [
	{
		title: 'Law Firms and Solo Practitioners',
		body: 'Personal injury, estate, and commercial matters that have stalled or are too complex for a standard mediation. Peter gives counsel the read on the file they need to advise their clients confidently.',
	},
	{
		title: 'Estate and Wills Variation',
		body: 'Files where family relationships are strained, timelines are urgent, and a court process would cost more than the estate can bear. A binding outcome, with privacy protected throughout.',
	},
	{
		title: 'Corporate and Commercial Parties',
		body: 'Shareholder, partnership, and contractual disputes where a binding outcome matters and the cost of full-blown litigation is disproportionate to the amount at stake.',
	},
	{
		title: 'Sports Organizations',
		body: 'Membership, eligibility, sanctions, and governance decisions that need to be made quickly, fairly, and by someone with real governance experience. Peter has served at every level of organized sport in Canada.',
	},
];

const credentialLines = [
	['KC', 'Harvard Certified', 'Med-Arb Specialist'],
	['Mediate BC Civil Roster'],
	['Law Society of BC', 'Called to Bar 1981'],
];

const testimonials = [
	{
		name: 'Nassim Baharian',
		role: 'Associate',
		firm: 'Singleton Urquhart Reynolds Vogel LLP',
		quote:
			'I would not hesitate to recommend Peter Buxton as a mediator.\n\nPeter demonstrated exceptional professionalism and dedication throughout the mediation. He took the time to speak with counsel and the parties in advance, remained fully engaged throughout the process, and was genuinely committed to helping the parties reach a resolution.',
	},

];

function splitQuote(quote) {
	const [firstParagraph, ...restParagraphs] = quote.split('\n\n');
	const sentenceEnd = firstParagraph.indexOf('. ');
	const firstSentence = sentenceEnd === -1 ? firstParagraph : firstParagraph.slice(0, sentenceEnd + 1);
	const restOfFirst = sentenceEnd === -1 ? '' : firstParagraph.slice(sentenceEnd + 1);
	return { firstSentence, restOfFirst, restParagraphs };
}

const faqs = [
	{
		q: 'What is Med-Arb?',
		a: 'A hybrid process that begins as a mediation. If the parties reach full settlement, the file closes there. If issues remain, the same neutral transitions into arbitration and delivers a binding written decision. Parties agree to this structure upfront, in writing.',
	},
	{
		q: 'Why use the same person for both roles?',
		a: 'Continuity. The med-arbitrator already understands the file, the parties, and the issues in dispute. There is no handoff, no duplication of preparation costs, and no loss of context. The transition is seamless.',
	},
	{
		q: 'Is the arbitral decision enforceable?',
		a: 'Yes. A med-arb agreement is a binding civil contract. The arbitrator’s award is final and can be filed in court. It is not subject to appeal unless the parties have agreed otherwise.',
	},
	{
		q: 'What does it cost compared to litigation?',
		a: 'Significantly less. Depending on complexity, the total cost across both phases is a fraction of what a multi-day trial can run, without the added risk of an adverse costs award if you lose.',
	},
	{
		q: 'How long does it take?',
		a: 'Most files resolve within three to six months of signing the Med-Arb agreement. Court timelines for a comparable matter in BC currently run three years or longer.',
	},
	{
		q: 'What types of disputes is Med-Arb suited for?',
		a: 'Any dispute where a binding outcome is needed and court timelines are unacceptable. Common applications include personal injury, estate and wills variation, commercial and shareholder disputes, employment, and sports governance.',
	},
	{
		q: 'How is procedural fairness protected?',
		a: 'Peter addresses this directly at intake. The Med-Arb agreement specifies what information from the mediation phase can and cannot inform the arbitration. Parties with concerns about the single-neutral model can discuss alternatives on the initial call.',
	},
	{
		q: 'How does Peter handle the pre-mediation process?',
		a: 'Peter conducts teleconferences with counsel before every file begins. This gives him a clear picture of what is and is not in the mediation brief, and allows him to understand the real issues before anyone is in the room together.',
	},
];

// Hexagon geometry extracted from /public/Buxton_ADR_Badge.png:
// pointy-top regular hexagons, width:height ≈ √3:2 (measured 0.859).
// Single hexagon in a 174×200 box (r=100 → W=173.2, H=200).
const HEX = '87,2 172,51 172,149 87,198 2,149 2,51';
// Small heading accent hexagon (Appellate Red outline).
const hexTiny = `<svg viewBox="0 0 174 200" width="12" height="14" aria-hidden="true" class="inline-block shrink-0"><polygon points="${HEX}" class="hex-line-red" stroke-width="10"/></svg>`;
// Small heading accent hexagon, light slate variant for dark backgrounds.
const hexTinyLight = `<svg viewBox="0 0 174 200" width="12" height="14" aria-hidden="true" class="inline-block shrink-0"><polygon points="${HEX}" class="hex-line" stroke-width="10"/></svg>`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Buxton ADR | Peter Buxton KC — Mediator · Arbitrator · Med-Arb Specialist</title>
		<meta
			name="description"
			content="Peter Buxton KC — forty-five years in the room. Med-Arb delivers a binding decision in months, not years, with every chance to settle first. Mediation, arbitration, and Med-Arb across British Columbia."
		/>
	</head>
	<body class="bg-clean-page font-sans text-slate-ink antialiased">
		<!-- Header / Nav -->
		<header class="sticky top-0 z-50 border-b border-measured/40 bg-clean-page">
			<nav class="relative mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3 sm:py-4">
				<a href="#top" class="flex items-center" aria-label="Buxton ADR home">
					<img
	src="logos/buxton-adr-horizontal-light.png"
	alt="Buxton ADR — Mediation · Arbitration · Med-Arb"
	width="1000"
	height="400"
	class="h-[86px] w-auto object-contain transition-transform duration-300 sm:h-[118px]"
/>
				</a>

				<!-- Mobile menu toggle -->
				<input type="checkbox" id="nav-toggle" class="peer hidden" />
				<label
					for="nav-toggle"
					aria-label="Toggle navigation menu"
					class="flex h-11 w-11 flex-shrink-0 cursor-pointer items-center justify-center self-center text-slate-ink peer-checked:hidden md:hidden"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</label>

				<!-- Close control — sits at the open panel's top-right, replacing the hamburger while the menu is open -->
				<label
					for="nav-toggle"
					aria-label="Toggle navigation menu"
					class="absolute right-6 top-3 hidden h-11 w-11 flex-shrink-0 cursor-pointer items-center justify-center text-slate-ink peer-checked:flex sm:top-4 md:hidden"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</label>

				<div class="hidden w-full basis-full flex-col gap-x-10 gap-y-4 border-t border-slate-ink/10 pb-3 pt-4 peer-checked:flex md:flex md:w-auto md:basis-auto md:flex-row md:items-center md:border-0 md:pb-0 md:pt-0 md:mt-2">
					<ul class="flex flex-col gap-x-10 gap-y-3 text-base font-medium tracking-wider text-slate-ink/80 md:flex-row md:items-center">
						{navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="block border-b-2 border-transparent pb-0.5 transition-colors hover:border-appellate hover:text-appellate"
								>{link.label}</a>
							</li>
						))}
					</ul>
					<a href="#book" class="btn-nav w-fit">Book a Call</a>
				</div>
			</nav>
		</header>

		<main id="top">
			<!-- 01 — HERO -->
			<section class="hero-depth relative isolate overflow-visible text-white">

				<!-- Ghost badge geometry, clipped to the hero -->
				<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
					<!-- Oversized single hexagon behind the headline -->
					<svg viewBox="0 0 174 200" class="absolute -left-24 top-4 h-[135%] w-auto opacity-[0.10] sm:-left-16" aria-hidden="true">
						<polygon points={HEX} class="hex-line" stroke-width="1.1" vector-effect="non-scaling-stroke" />
					</svg>
					<!-- Overlapping badge trefoil, very faint, lower-left -->
					<svg viewBox="-180 -105 360 316" class="absolute -bottom-16 left-[38%] hidden h-[85%] w-auto opacity-[0.06] lg:block" aria-hidden="true">
						<polygon points="0,-100 86.6,-50 86.6,50 0,100 -86.6,50 -86.6,-50" class="hex-line" stroke-width="1.2" vector-effect="non-scaling-stroke" />
						<polygon points="-86.6,6 0,56 0,156 -86.6,206 -173.2,156 -173.2,56" class="hex-line" stroke-width="1.2" vector-effect="non-scaling-stroke" />
						<polygon points="86.6,6 173.2,56 173.2,156 86.6,206 0,156 0,56" class="hex-line" stroke-width="1.2" vector-effect="non-scaling-stroke" />
					</svg>
				</div>

				<div class="grid w-full grid-cols-1 items-stretch gap-0 lg:grid-cols-[3.2fr_2fr]">
					<!-- Text plane (≈60%) -->
					<div class="hero-fade-text relative z-10 ml-auto w-full max-w-[46rem] px-6 py-12 sm:py-20 lg:px-12 lg:py-24">
						
						<p class="eyebrow mt-5 text-white/55">Mediator · Arbitrator · Med-Arb Specialist</p>
						<div class="relative mt-12">
	<div class="absolute -left-6 top-3 hidden h-[82%] w-px bg-measured/70 lg:block"></div>
	<h1 class="hero-h1">Five decades in the room.</h1>
</div>
						<div class="mt-8 max-w-lg space-y-4 text-lg leading-relaxed text-white/85">
							<p>Since 1981, Peter Buxton KC has appeared as counsel in the Provincial Court, the BC Supreme Court, and the BC Court of Appeal. Lawyers who need an authority who has lived that experience, not just studied it, call Peter Buxton KC.</p>
		
						</div>
						<div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
							<a href="#book" class="btn btn-primary">Book a Call</a>
							<a href="tel:+16044922690" class="btn btn-ghost">604-492-2690</a>
						</div>
					</div>

					<!-- Portrait plane -->
<div class="hero-fade-portrait relative z-20 order-first min-h-[24rem] overflow-hidden bg-slate-ink sm:min-h-[30rem] lg:order-none lg:min-h-[40rem] lg:my-8 lg:mr-8">
	<img
		src="images/Peter_Image_2.jpg"
		alt="Peter Buxton KC"
		width="684"
		height="684"
		class="absolute inset-0 h-full w-full object-cover object-[50%_18%]"
	/>

	<!-- Subtle transition between the text and portrait -->
	<div class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-gradient-to-r from-deep-teal/20 to-transparent"></div>
</div>

	<!-- Soft transition between the text and portrait planes -->
	<div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-slate-ink/20 via-transparent to-transparent"></div>

	<!-- Appellate Red division line -->
	<div class="pointer-events-none absolute inset-y-0 left-0 w-px bg-measured/70"></div>
</div>
				</div>
			</section>

<!-- 02 — PRACTICE -->
<section id="practice" class="bg-clean-page">
	<div class="mx-auto max-w-6xl px-6 pb-20 pt-14 sm:pb-24 sm:pt-20 lg:pt-20">
		<div class="max-w-2xl">
			<h2 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
				Practice
			</h2>
		</div>

		<div class="mt-12 grid gap-6 lg:grid-cols-3 lg:items-start">
						{practice.map((card) => (
							<div
								class={`relative flex h-full flex-col rounded p-9 ${
									card.featured
										? 'border-2 border-appellate bg-open-brief shadow-sm sm:p-10 lg:-mx-3 lg:-mt-8 lg:pb-12 lg:shadow-lg'
										: 'border border-slate-ink/10 bg-white'
								}`}
							>
					
								<h3 class={`font-serif font-semibold text-slate-ink ${card.featured ? 'text-[1.75rem]' : 'text-xl'}`}>
									{card.title}
								</h3>
								<div class={`mt-3 h-px ${card.featured ? 'w-16 bg-appellate' : 'w-12 bg-measured'}`}></div>
								<p class="mt-5 flex-1 leading-relaxed text-slate-ink/75" set:html={card.body} />
								{card.featured && (
									<a href="#med-arb" class="link-arrow mt-7 text-sm font-semibold text-appellate">
										How Med-Arb works <span aria-hidden="true">&rarr;</span>
									</a>
								)}
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- 03 — WHO HE WORKS WITH -->
<section class="bg-open-brief">
	<div class="mx-auto max-w-6xl px-6 pb-0 pt-0">
		<div class="max-w-2xl">
			<h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
				Who He Works With
			</h2>

			<p class="mt-2 leading-relaxed text-slate-ink/75">
				Peter works primarily with lawyers and law firms who need a neutral they can trust to run a
				professional process and, when asked, give an honest read on the file.
			</p>
		</div>

		<div class="mt-5 divide-y divide-slate-ink/10">
			{worksWith.map((panel) => (
				<div class="reveal py-5 sm:py-6">
					<h3 class="font-serif text-xl font-semibold text-slate-ink">
						{panel.title}
					</h3>

					<p class="mt-3 max-w-4xl leading-relaxed text-slate-ink/75">
						{panel.body}
					</p>
				</div>
			))}
		</div>
	</div>
</section>

			<!-- 04 — CREDENTIALS -->
			<section id="about" class="bg-clean-page">
				<div class="reveal mx-auto max-w-6xl px-6 py-20 sm:py-24">
					<div class="grid gap-14 lg:grid-cols-[0.92fr_1.08fr] lg:items-start lg:gap-20">
						<div class="lg:order-1">
						
							<h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">Why Peter.</h2>
							<div class="mt-6 space-y-5 leading-relaxed text-slate-ink/80">
								<p>
									Peter Buxton has been a trial lawyer in BC since 1981. He has appeared before the Provincial Court, the BC Supreme Court, and the BC Court of Appeal in personal injury, criminal, family, estate, corporate, and labour matters.
								</p>
								<p>
									He is a rostered member of Mediate BC, a practicing member of the Law Society of British
									Columbia, and a current member of the Canadian Bar Association, the Surrey Bar Association,
									and the New Westminster Bar Association. He serves as a mentor to two generations of BC trial
									lawyers and continues to act as a sounding board for counsel preparing complex files.
								</p>
							</div>
							<div class="mt-8 flex flex-col gap-y-2 font-mono text-xs tracking-wide text-slate-ink/70">
								{credentialLines.map((line) => (
									<p class="flex items-center">
										{line.map((tag) => (
											<span class="border-slate-ink/25 px-3 first:pl-0 last:border-r-0 last:pr-0 border-r">{tag}</span>
										))}
									</p>
								))}
							</div>
						</div>
						<div class="lg:order-2">
							<figure>
								<img
									src="images/Peter_Image.jpg"
									alt="Peter Buxton KC — mediator, arbitrator, and Med-Arb specialist"
									width="750"
									height="500"
									class="aspect-[4/3] w-full rounded object-cover"
								/>
							</figure>
							<figure class="mt-6">

								<blockquote class="font-serif text-lg italic leading-relaxed text-slate-ink sm:text-xl">
									It’s not about the mediator. It’s about asking the right questions, and giving the person
									across the table the confidence to tell you where they actually stand.
								</blockquote>
								<figcaption class="eyebrow mt-4 text-measured">Peter Buxton KC</figcaption>
							</figure>
						</div>
					</div>
				</div>
			</section>

			<!-- 05 — TESTIMONIALS -->
			<section class="relative isolate overflow-hidden bg-deep-teal text-white">
				<!-- Subtle brand-toned background texture -->
				<div class="testimonial-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
				<!-- Faint badge geometry behind testimonials -->
				<svg viewBox="0 0 174 200" class="pointer-events-none absolute -right-16 top-8 -z-10 h-[120%] w-auto opacity-[0.05]" aria-hidden="true">
					<polygon points={HEX} class="hex-line" stroke-width="1.2" vector-effect="non-scaling-stroke" />
				</svg>
				<div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
					<div class="max-w-2xl">
					
						<h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
							What Counsel Say
						</h2>
					</div>
					<div id="testimonial-carousel" class="mt-10 max-w-3xl">
						<div class="relative min-h-[360px] sm:min-h-[280px]" data-testimonial-track>
							{testimonials.map((t, i) => {
								const q = splitQuote(t.quote);
								return (
									<figure
										class={`testimonial-slide absolute inset-0 ${i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0'}`}
										data-testimonial-slide
										aria-hidden={i === 0 ? 'false' : 'true'}
									>
										
										<blockquote class="mt-2 max-w-[650px] font-serif text-white/90">
											<p class="text-xl italic leading-snug text-white sm:text-2xl">
												<em class="italic">{q.firstSentence}</em>{q.restOfFirst}
											</p>
											{q.restParagraphs.map((p) => (
												<p class="mt-3 text-base leading-relaxed text-white/75 sm:text-lg">{p}</p>
											))}
										</blockquote>
										<figcaption class="mt-4 border-t border-white/15 pt-3">
											<p class="font-semibold text-white">{t.name ?? t.role}</p>
											<p class="text-sm text-white/60">{t.name ? `${t.role} · ${t.firm}` : t.firm}</p>
										</figcaption>
									</figure>
								);
							})}
						</div>

					</div>
				</div>
			</section>

			<!-- 06 — MED-ARB FAQ -->
			<section id="med-arb" class="bg-open-brief">
				<div class="mx-auto max-w-4xl px-6 py-20 sm:py-28">
					<div class="max-w-2xl">
					
						<h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
							Understanding Med-Arb
						</h2>
						<p class="mt-5 leading-relaxed text-slate-ink/75">
							Med-Arb is still unfamiliar to many lawyers and parties outside the field. These are the
							questions Peter is most often asked on an intake call.
						</p>
					</div>
					<div class="mt-12 divide-y divide-slate-ink/10 border-y border-slate-ink/10">
						{faqs.map((faq) => (
							<details class="faq group">
								<summary class="flex items-center justify-between gap-6 py-5">
									<span class="font-serif text-lg font-semibold text-slate-ink">{faq.q}</span>
									<span class="chev flex h-6 w-6 flex-shrink-0 items-center justify-center text-2xl font-light leading-none text-appellate">+</span>
								</summary>
								<p class="pb-6 pr-10 leading-relaxed text-slate-ink/75">{faq.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<!-- 07 — BOOK A CALL -->
			<section id="book" class="bg-clean-page">
				<div class="mx-auto max-w-6xl px-6 pt-20 pb-10 sm:pt-24 sm:pb-12">
					<div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
						<div>
					
							<h2 class="mt-4 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
								Start the Conversation
							</h2>
							<p class="mt-3 leading-relaxed text-slate-ink/80">
								Peter is available for a complimentary 20-minute intake call to discuss the file, confirm
								whether the process is a fit, and outline likely fees and timelines.
							</p>

							<dl class="mt-6 space-y-3 text-slate-ink/85">
								<div class="flex gap-3">
									<dt class="w-20 flex-shrink-0 text-sm font-semibold uppercase tracking-wide text-slate-ink/50">Phone</dt>
									<dd><a href="tel:+16044922690" class="font-medium text-measured hover:text-slate-ink">604-492-2690</a></dd>
								</div>
								<div class="flex gap-3">
									<dt class="w-20 flex-shrink-0 text-sm font-semibold uppercase tracking-wide text-slate-ink/50">Email</dt>
									<dd><a href="mailto:admin@buxtonadr.ca" class="font-medium text-measured hover:text-slate-ink">admin@buxtonadr.ca</a></dd>
								</div>
								<div class="flex gap-3">
									<dt class="w-20 flex-shrink-0 text-sm font-semibold uppercase tracking-wide text-slate-ink/50">LinkedIn</dt>
									<dd><a href="https://linkedin.com/in/pbuxton" target="_blank" rel="noopener" class="font-medium text-measured hover:text-slate-ink">linkedin.com/in/pbuxton</a></dd>
								</div>
							</dl>

							<div class="mt-6 rounded-lg border border-slate-ink/10 bg-open-brief p-5">
								<p class="text-sm leading-relaxed text-slate-ink/75">
									Scheduling and logistics are managed by our administrative office. Please review the calendar for available dates and submit your preferred date using the booking form.
								</p>
							</div>
						</div>

						<div>
							<!-- Availability calendar (live Google Calendar integration) -->
							<div class="mb-4 flex items-center justify-between">
								<button id="cal-prev" class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-slate-ink/20 text-lg text-slate-ink/60 transition-colors hover:border-appellate hover:text-appellate">&#8249;</button>
								<span id="cal-title" class="font-serif text-lg font-semibold text-slate-ink"></span>
